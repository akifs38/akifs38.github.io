---
const links = [
  ['#hakkinda', 'Hakkında'],
  ['#gezilecek', 'Gezilecek Yerler'],
  ['#doga', 'Doğa & Şelaleler'],
  ['#tarihce', 'Tarihçe'],
  ['#kultur', 'Kültür'],
  ['#galeri', 'Galeri'],
  ['#harita', 'Harita'],
  ['#iletisim', 'İletişim'],
