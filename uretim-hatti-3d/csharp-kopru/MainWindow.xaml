<Window x:Class="UretimHatti3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="3D Üretim Hattı Takibi — S7-300" Height="820" Width="1280"
        WindowState="Maximized" Background="#0e1116">
    <Grid>
        <wv2:WebView2 x:Name="web"/>
        <Border x:Name="statusBar" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Background="#161b22" BorderBrush="#2a323d" BorderThickness="1"
                CornerRadius="8" Padding="10,6" Margin="12">
            <TextBlock x:Name="statusText" Foreground="#8a96a3" FontFamily="Consolas" FontSize="12"
                       Text="Başlatılıyor…"/>
        </Border>
    </Grid>
</Window>
